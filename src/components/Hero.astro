---
const PHONE = "06 74 98 15 99";
const TEL = "tel:+33674981599";
const { title, tagline, emergency } = Astro.props as { title: string; tagline?: string; emergency?: boolean };
const amp = "&";
---
<section class="relative isolate overflow-hidden">
  <img src="/assets/hero-plumbing.webp" alt="Artisan plombier chauffagiste intervenant sur une chaudière à Saint-James" width="1920" height="1280" class="absolute inset-0 h-full w-full object-cover" />
  <div class="absolute inset-0 bg-gradient-hero" />
  <div class="container relative py-20 md:py-32 text-primary-foreground">
    <div class="inline-flex items-center gap-2 rounded-full bg-secondary/95 text-secondary-foreground px-4 py-2 text-sm font-bold mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      Saint-James (50240) — Sud-Manche et Ille-et-Vilaine
    </div>
    <h1 class="text-4xl md:text-6xl font-black max-w-4xl leading-tight">{title}</h1>
    {tagline && <p class="mt-6 text-lg md:text-2xl max-w-2xl text-primary-foreground/90 font-medium">{tagline}</p>}
    <div class="mt-10 flex flex-col sm:flex-row gap-4">
      <a href={TEL} class="inline-flex items-center justify-center gap-3 rounded-xl bg-secondary px-8 py-5 text-lg font-extrabold text-secondary-foreground shadow-cta hover:brightness-105 transition">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        {emergency ? `Urgence — ${PHONE}` : PHONE}
      </a>
      <a href="/#services" class="inline-flex items-center justify-center gap-2 rounded-xl bg-background/10 backdrop-blur border-2 border-primary-foreground/40 px-8 py-5 text-lg font-bold text-primary-foreground hover:bg-background/20 transition">Tous les services</a>
    </div>
  </div>
</section>
