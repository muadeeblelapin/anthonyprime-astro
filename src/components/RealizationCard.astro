---
import type { Realization } from "../lib/services"
export interface Props { realization: Realization }
const { realization: r } = Astro.props
const count = r.images.length
const gid = `g-${r.title.replace(/\s+/g,"-").toLowerCase()}`
const srcs = r.images.map(i => i.fullImage).join(",")
const caps = r.images.map(i => i.caption || "").join("|")
---
<article class="group rounded-2xl border border-border bg-card overflow-hidden hover:shadow-elegant hover:-translate-y-1 transition-all duration-300">
  {count > 0 ? <>
    <button type="button" class="block w-full aspect-video bg-muted overflow-hidden cursor-zoom-in" onclick={`openLB('${srcs}','${caps}')`} aria-label={`Agrandir : ${r.title}`}>
      <img src={r.images[0].thumbnail} alt={`${r.title} — ${r.location}`} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
    </button>
  </> : <div class="aspect-video bg-muted flex items-center justify-center"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10 text-muted-foreground/40"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></div>}
  <div class="p-6">
    <h3 class="text-lg text-card-foreground mb-1">{r.title}</h3>
    <p class="text-sm text-muted-foreground inline-flex items-center gap-1"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg> {r.location}</p>
  </div>
</article>