---
import { SERVICES } from "../lib/services"

// Sélection éditoriale : les salles de bains d'abord, puis d'autres chantiers
// pour montrer l'étendue du savoir-faire. On retrouve l'entrée par (service, ville).
const pick = (slug: string, ville: string) => {
  const service = SERVICES[slug]
  if (!service) return null
  const realization = service.realizations.find((r) => r.location.startsWith(ville))
  return realization ? { service, realization } : null
}

const featured = [
  pick("renovation-salle-de-bains", "Saint-Martin-des-Champs"),
  pick("renovation-salle-de-bains", "Saint-Hilaire-du-Harcouët"),
  pick("renovation-salle-de-bains", "Granville"),
  pick("pompe-a-chaleur", "Saint-James"),
  pick("electricite", "Saint-James"),
  pick("climatisation", "Saint-James"),
].filter((x): x is { service: any; realization: any } => x !== null)
---

<section id="realisations" class="py-20 md:py-28 bg-muted">
  <div class="container">
    <div class="max-w-2xl mb-12">
      <p class="text-primary font-bold uppercase tracking-wider text-sm mb-3">Réalisations</p>
      <h2 class="text-3xl md:text-5xl text-foreground">Mes chantiers en images</h2>
      <p class="mt-4 text-muted-foreground text-lg">
        Salles de bains, pompes à chaleur, électricité : découvrez des chantiers réellement
        réalisés dans le Sud-Manche. Cliquez sur une photo pour l'agrandir.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {featured.map(({ service, realization }) => {
        const r = realization
        const srcs = r.images.map((i: any) => i.fullImage).join(",")
        const caps = r.images.map((i: any) => i.caption || "").join("|")
        return (
          <button
            type="button"
            class="group relative block w-full aspect-[4/3] rounded-2xl overflow-hidden bg-card cursor-zoom-in text-left"
            onclick={`openLB('${srcs}','${caps}')`}
            aria-label={`Agrandir : ${r.title} à ${r.location}`}
          >
            <img
              src={r.images[0].thumbnail}
              alt={`${r.title} — ${r.location}`}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/55 to-transparent p-5 pt-14">
              <p class="text-white font-bold leading-tight">{r.title}</p>
              <p class="text-white/85 text-sm mt-0.5 flex items-center gap-1.5">
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                {r.location}
              </p>
              <p class="text-white/85 text-xs mt-1 uppercase tracking-wider font-bold">{service.name}</p>
            </div>
            <span class="absolute top-3 right-3 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-foreground opacity-0 group-hover:opacity-100 transition-opacity">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6"/><path d="M8 11h6"/></svg>
            </span>
          </button>
        )
      })}
    </div>

    <div class="text-center mt-12">
      <a
        href="/realisations/"
        class="inline-flex items-center gap-2 rounded-xl bg-primary px-8 py-4 font-extrabold text-primary-foreground shadow-elegant hover:brightness-110 transition"
      >
        Voir toutes mes réalisations
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>
