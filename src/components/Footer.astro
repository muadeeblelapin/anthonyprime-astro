---
const PHONE = "06 74 98 15 99";
const TEL = "tel:+33674981599";
const ADDRESS = "3, impasse de la Croix-Vincent, 50240 Saint-James";
const MAPS = "https://www.google.com/maps/search/?api=1&query=3+impasse+de+la+Croix-Vincent+50240+Saint-James";
---
<footer id="contact" class="bg-primary text-primary-foreground">
  <div class="container py-16">
    <div class="grid md:grid-cols-3 gap-10">
      <div>
        <h3 class="text-xl font-black mb-4">Anthony PRIME</h3>
        <p class="text-primary-foreground/90 leading-relaxed">Artisan plombier, chauffagiste et électricien. Au service des particuliers et professionnels du Sud-Manche depuis plusieurs années.</p>
      </div>
      <div>
        <h4 class="font-bold text-lg mb-4">CONTACT</h4>
        <ul class="space-y-3">
          <li><a href={TEL} class="inline-flex items-center gap-2 text-primary-foreground/90 hover:text-primary-foreground transition"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg> {PHONE}</a></li>
          <li><a href="mailto:anthonyprimelec@gmail.com" class="inline-flex items-center gap-2 text-primary-foreground/90 hover:text-primary-foreground transition"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg> anthonyprimelec@gmail.com</a></li>
          <li><a href={MAPS} target="_blank" rel="noopener noreferrer" class="inline-flex items-start gap-2 text-primary-foreground/90 hover:text-primary-foreground transition"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg> <span>{ADDRESS}</span></a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-bold text-lg mb-4">URGENCE ?</h4>
        <a href={TEL} class="inline-flex items-center gap-2 rounded-xl bg-secondary text-secondary-foreground px-6 py-3 font-extrabold shadow-elegant hover:brightness-105 transition"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg> Appeler maintenant</a>
      </div>
    </div>
  </div>
  <div class="border-t border-primary-foreground/20 py-6">
    <div class="container text-center text-sm text-primary-foreground/90">&copy; {new Date().getFullYear()} Anthony PRIME — Artisan plombier, chauffagiste et électricien à Saint-James (50240)</div>
  </div>
</footer>
