---
import { CITIES } from "../lib/cities"
---
<section id="zone" class="py-20 bg-muted">
  <div class="container">
    <div class="max-w-2xl mb-12">
      <p class="text-primary font-bold uppercase tracking-wider text-sm mb-3">LOCAL & RÉACTIF</p>
      <h2 class="text-3xl md:text-4xl text-foreground">Zone d'intervention : 30 km autour de Saint-James</h2>
      <p class="mt-4 text-muted-foreground text-lg">Un artisan de proximité pour les particuliers et professionnels du Sud-Manche et de l'Ille-et-Vilaine.</p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {CITIES.map(city => <a href={`/plombier-${city.slug}`} class="group rounded-xl border border-border bg-card p-5 hover:shadow-elegant hover:-translate-y-0.5 transition-all duration-200"><div class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg><span class="font-bold text-sm text-card-foreground group-hover:text-primary transition">Plombier à {city.name}</span></div></a>)}
    </div>
  </div>
</section>
