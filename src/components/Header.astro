---
const PHONE = "06 74 98 15 99";
const TEL = "tel:+33674981599";
---
<header class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="container flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-extrabold text-xl">
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary text-primary-foreground text-sm font-black">AP</span>
      <span class="hidden sm:inline">Anthony <span class="text-primary">PRIME</span></span>
    </a>
    <nav class="flex items-center gap-6 text-sm font-medium">
      <a href="/#services" class="text-muted-foreground hover:text-foreground transition">Services</a>
      <a href="/#zone" class="text-muted-foreground hover:text-foreground transition">Zone d'intervention</a>
      <a href="/#contact" class="text-muted-foreground hover:text-foreground transition">Contact</a>
    </nav>
    <a href={TEL} class="inline-flex items-center gap-2 rounded-xl bg-secondary text-secondary-foreground px-4 py-2 text-sm font-extrabold hover:brightness-105 transition shadow-cta">
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      {PHONE}
    </a>
  </div>
</header>
