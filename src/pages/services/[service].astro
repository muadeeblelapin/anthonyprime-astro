---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Header from "../../components/Header.astro"
import Footer from "../../components/Footer.astro"
import Hero from "../../components/Hero.astro"
import TrustBar from "../../components/TrustBar.astro"
import RealizationCard from "../../components/RealizationCard.astro"
import { SERVICES, BRANDS, ICON_MAP } from "../../lib/services"
export async function getStaticPaths() { return Object.entries(SERVICES).map(([slug, service]) => ({ params: { service: slug }, props: { service } })) }
const { service } = Astro.props
const PHONE = "06 74 98 15 99"
const TEL = "tel:+33674981599"
const IconPath = ICON_MAP[service.icon]

// Configuration du formulaire par service
const formConfigs: Record<string, { title: string; desc: string; options: { value: string; label: string }[] }> = {
  plomberie: { title: "Un projet de plomberie ou de salle de bains ?", desc: "Laissez-moi vos coordonnées, je vous contacte pour en discuter.", options: [{ value: "fuite", label: "Recherche de fuite" }, { value: "chauffe-eau", label: "Pose de chauffe-eau" }, { value: "salle-de-bains", label: "Rénovation / création salle de bains" }, { value: "sanitaires", label: "Sanitaires / raccordements" }, { value: "autre", label: "Autre" }] },
  chauffage: { title: "Un projet de chauffage ?", desc: "Laissez-moi vos coordonnées, je vous contacte pour en discuter.", options: [{ value: "chaudiere-gaz", label: "Chaudière gaz" }, { value: "chaudiere-fioul", label: "Chaudière fioul" }, { value: "pac", label: "Pompe à chaleur" }, { value: "plancher-chauffant", label: "Plancher chauffant" }, { value: "entretien", label: "Entretien / dépannage" }, { value: "autre", label: "Autre" }] },
  electricite: { title: "Un projet électrique ?", desc: "Laissez-moi vos coordonnées, je vous contacte pour en discuter.", options: [{ value: "tableau", label: "Tableau électrique / mise aux normes" }, { value: "depannage", label: "Dépannage électrique" }, { value: "eclairage", label: "Éclairage / prises" }, { value: "autre", label: "Autre" }] },
  "depannage-urgence": { title: "Une urgence ?", desc: "Appelez-moi directement au {PHONE} pour une intervention rapide. Ou laissez-moi vos coordonnées, je vous rappelle.", options: [{ value: "fuite-eau", label: "Fuite d'eau" }, { value: "panne-chauffage", label: "Panne de chauffage" }, { value: "panne-electrique", label: "Coupure électrique" }, { value: "autre", label: "Autre urgence" }] },
  "pompe-a-chaleur": { title: "Un projet de pompe à chaleur ?", desc: "Laissez-moi vos coordonnées, je vous contacte pour une étude personnalisée.", options: [{ value: "pac-air-eau", label: "PAC air/eau (aérothermie)" }, { value: "pac-geo", label: "PAC géothermie" }, { value: "clim-reversible", label: "Climatisation réversible" }, { value: "remplacement", label: "Remplacement de chaudière par PAC" }, { value: "entretien", label: "Entretien / dépannage PAC" }, { value: "autre", label: "Autre" }] },
  climatisation: { title: "Un projet de climatisation ?", desc: "Laissez-moi vos coordonnées, je vous contacte pour une étude personnalisée.", options: [{ value: "installation", label: "Installation clim réversible" }, { value: "entretien", label: "Entretien climatisation" }, { value: "depannage", label: "Dépannage clim" }, { value: "autre", label: "Autre" }] },
  aerothermie: { title: "Un projet d'aérothermie ?", desc: "Laissez-moi vos coordonnées, je vous contacte pour une étude personnalisée.", options: [{ value: "installation", label: "Installation PAC air/eau" }, { value: "remplacement", label: "Remplacement de chaudière" }, { value: "entretien", label: "Entretien / dépannage" }, { value: "autre", label: "Autre" }] },
  geothermie: { title: "Un projet de géothermie ?", desc: "Laissez-moi vos coordonnées, je vous contacte pour une étude personnalisée.", options: [{ value: "installation", label: "Installation PAC géothermie" }, { value: "remplacement", label: "Remplacement de chaudière" }, { value: "entretien", label: "Entretien / dépannage" }, { value: "autre", label: "Autre" }] },
  "renovation-salle-de-bains": { title: "Un projet de salle de bains ?", desc: "Laissez-moi vos coordonnées, je vous contacte pour un devis gratuit.", options: [{ value: "creation", label: "Création complète" }, { value: "renovation", label: "Rénovation" }, { value: "douche-italienne", label: "Douche à l'italienne" }, { value: "pmr", label: "Salle de bains PMR / adaptée" }, { value: "autre", label: "Autre" }] },
  "entretien-chaudiere-gaz": { title: "Je m'occupe de l'entretien de votre chaudière gaz", desc: "Laissez-moi vos coordonnées, je vous contacte pour planifier l'entretien.", options: [{ value: "chaudiere-gaz", label: "Chaudière gaz" }, { value: "chaudiere-condensation", label: "Chaudière à condensation" }, { value: "autre", label: "Autre" }] },
  "entretien-chaudiere-fioul": { title: "Je m'occupe de l'entretien de votre chaudière fioul", desc: "Laissez-moi vos coordonnées, je vous contacte pour planifier l'entretien.", options: [{ value: "chaudiere-fioul", label: "Chaudière fioul" }, { value: "autre", label: "Autre" }] },
  "entretien-pac": { title: "Je m'occupe de l'entretien de votre PAC", desc: "Laissez-moi vos coordonnées, je vous contacte pour planifier l'entretien.", options: [{ value: "pac-air-eau", label: "PAC air/eau (aérothermie)" }, { value: "pac-geo", label: "PAC géothermie" }, { value: "autre", label: "Autre" }] },
  "entretien-climatisation": { title: "Je m'occupe de l'entretien de votre climatisation", desc: "Laissez-moi vos coordonnées, je vous contacte pour planifier l'entretien.", options: [{ value: "clim-reversible", label: "Climatisation réversible" }, { value: "clim-fixe", label: "Climatisation fixe" }, { value: "autre", label: "Autre" }] },
}
const form = formConfigs[service.slug] || formConfigs.plomberie
---
<BaseLayout title={`${service.name} à Saint-James (50240) — Anthony PRIME`} description={`${service.name} à Saint-James et alentours : ${service.tagline} Artisan RGE — devis gratuit.`} path={`/services/${service.slug}/`}>
  <Fragment slot="header"><Header /></Fragment>
  <Hero title={`${service.name} à Saint-James (50240) et alentours`} tagline={service.tagline} emergency={service.emergency} />
  {service.emergency && <section class="bg-secondary text-secondary-foreground"><div class="container py-6 flex flex-col md:flex-row items-center justify-between gap-4"><p class="font-bold text-lg flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg> Une urgence ? Appelez immédiatement.</p><a href={TEL} class="inline-flex items-center gap-2 rounded-xl bg-primary text-primary-foreground px-6 py-3 font-extrabold shadow-elegant"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg> {PHONE}</a></div></section>}
  <TrustBar />
  <section class="py-20 bg-background"><div class="container grid lg:grid-cols-2 gap-12 items-start">
    <div><p class="text-primary font-bold uppercase tracking-wider text-sm mb-3 inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={IconPath}/></svg> Notre prestation</p><h2 class="text-3xl md:text-4xl mb-5">{service.name} — savoir-faire local</h2><p class="text-lg text-muted-foreground leading-relaxed mb-6" set:html={service.description.replace(/\n/g, '<br/>')} /><ul class="space-y-3">{service.bullets.map(b => <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-primary shrink-0 mt-0.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span class="text-foreground">{b}</span></li>)}</ul></div>
    <aside class="rounded-2xl border border-border bg-card p-8 shadow-elegant"><p class="text-primary font-bold uppercase tracking-wider text-sm mb-4">Artisan certifié</p><h3 class="text-2xl mb-6">Vos garanties</h3><ul class="space-y-4">
      <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7 text-primary shrink-0"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><polyline points="9 11 12 14 22 4"/></svg><div><p class="font-bold">Certifié RGE</p><p class="text-sm text-muted-foreground">Reconnu Garant de l'Environnement — clé d'accès aux aides.</p></div></li>
      <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7 text-primary shrink-0"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg><div><p class="font-bold">Qualibat</p><p class="text-sm text-muted-foreground">Qualification professionnelle reconnue dans le bâtiment.</p></div></li>
      <li class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7 text-primary shrink-0"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a6 6 0 1 1-12 0c0-1.5.5-2.5 1.5-3.5z"/></svg><div><p class="font-bold">Professionnel du Gaz</p><p class="text-sm text-muted-foreground">Habilité pour l'installation et l'entretien gaz.</p></div></li>
    </ul></aside>
  </div></section>
  <section class="py-20 bg-muted"><div class="container"><div class="max-w-2xl mb-12"><p class="text-primary font-bold uppercase tracking-wider text-sm mb-3">Réalisations</p><h2 class="text-3xl md:text-4xl text-foreground">Nos derniers chantiers {service.name.toLowerCase()}</h2><p class="mt-4 text-muted-foreground text-lg">Un aperçu de nos interventions récentes dans le Sud-Manche et l'Ille-et-Vilaine.</p></div><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{service.realizations.map(r => <RealizationCard realization={r} />)}</div></div></section>
  {service.showBrands && <section class="py-16 bg-background"><div class="container"><div class="max-w-2xl mb-8"><p class="text-primary font-bold uppercase tracking-wider text-sm mb-3">Marques partenaires</p><h2 class="text-2xl md:text-3xl">Des équipements de référence</h2></div><div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">{BRANDS.map(b => <div class="rounded-xl border border-border bg-card px-5 py-6 text-center font-bold text-card-foreground hover:shadow-elegant transition">{b}</div>)}</div></div></section>}
  {service.showAids && <section class="py-20 bg-muted"><div class="container"><div class="max-w-3xl"><p class="text-primary font-bold uppercase tracking-wider text-sm mb-3 inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg> Aides financières</p><h2 class="text-3xl md:text-4xl mb-5">Profitez de MaPrimeRénov' et des aides à la rénovation</h2><p class="text-muted-foreground text-lg mb-8">En tant qu'artisan RGE, Anthony PRIME vous permet de bénéficier des principales aides de l'État pour financer vos travaux d'économie d'énergie.</p></div><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{[{t:"MaPrimeRénov'",d:"Aide de l'État, calculée selon vos revenus et le gain énergétique."},{t:"CEE",d:"Certificats d'Économies d'Énergie : prime versée par les fournisseurs d'énergie."},{t:"TVA 5,5 %",d:"Taux réduit pour les travaux d'amélioration énergétique."}].map(a => <div class="rounded-2xl border border-border bg-card p-6 shadow-elegant"><h3 class="font-bold text-xl mb-2">{a.t}</h3><p class="text-sm text-muted-foreground">{a.d}</p></div>)}</div></div></section>}
  {service.forfaits && <section class="py-20 bg-background"><div class="container"><div class="max-w-2xl mb-12"><p class="text-primary font-bold uppercase tracking-wider text-sm mb-3">Forfaits</p><h2 class="text-3xl md:text-4xl text-foreground">Tarifs d'entretien {service.name.toLowerCase()}</h2><p class="mt-4 text-muted-foreground text-lg">Prix hors pièces de rechange. Devis gratuit pour toute intervention.</p></div><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{service.forfaits.map(f => <div class="rounded-2xl border border-border bg-card p-6 shadow-elegant flex flex-col"><div class="flex items-center justify-between mb-4"><h3 class="text-xl font-bold text-card-foreground">{f.name}</h3><span class="text-2xl font-black text-primary">{f.price}</span></div><p class="text-sm text-muted-foreground leading-relaxed flex-1">{f.desc}</p></div>)}</div></div></section>}
  <section class="py-20 bg-muted" id="contact-form">
    <div class="container max-w-2xl">
      <div class="text-center mb-10">
        <p class="text-primary font-bold uppercase tracking-wider text-sm mb-3">Sans engagement</p>
        <h2 class="text-3xl md:text-4xl">{form.title}</h2>
        <p class="mt-4 text-muted-foreground text-lg">{form.desc}</p>
      </div>
      <form action="https://formspree.io/f/xnjekrrg" method="POST" class="space-y-5">
        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block text-sm font-bold mb-2">Nom et prénom</label>
            <input type="text" id="name" name="name" required class="w-full rounded-xl border border-border bg-background px-4 py-3 text-foreground focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Votre nom" />
          </div>
          <div>
            <label for="phone" class="block text-sm font-bold mb-2">Téléphone</label>
            <input type="tel" id="phone" name="phone" required class="w-full rounded-xl border border-border bg-background px-4 py-3 text-foreground focus:outline-none focus:ring-2 focus:ring-primary" placeholder="06 XX XX XX XX" />
          </div>
        </div>
        <div>
          <label for="email" class="block text-sm font-bold mb-2">Email</label>
          <input type="email" id="email" name="email" class="w-full rounded-xl border border-border bg-background px-4 py-3 text-foreground focus:outline-none focus:ring-2 focus:ring-primary" placeholder="votre@email.fr (optionnel)" />
        </div>
        <div>
          <label for="equipment" class="block text-sm font-bold mb-2">Type de projet</label>
          <select id="equipment" name="equipment" required class="w-full rounded-xl border border-border bg-background px-4 py-3 text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
            <option value="">Sélectionnez...</option>
            {form.options.map(o => <option value={o.value}>{o.label}</option>)}
          </select>
        </div>
        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="city" class="block text-sm font-bold mb-2">Ville</label>
            <input type="text" id="city" name="city" class="w-full rounded-xl border border-border bg-background px-4 py-3 text-foreground focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Votre ville" />
          </div>
          <div>
            <label for="availability" class="block text-sm font-bold mb-2">Disponibilités</label>
            <select id="availability" name="availability" class="w-full rounded-xl border border-border bg-background px-4 py-3 text-foreground focus:outline-none focus:ring-2 focus:ring-primary">
              <option value="">À votre convenance</option>
              <option value="matin">Matin (8h-12h)</option>
              <option value="apres-midi">Après-midi (13h30-17h15)</option>
            </select>
          </div>
        </div>
        <div>
          <label for="message" class="block text-sm font-bold mb-2">Message (optionnel)</label>
          <textarea id="message" name="message" rows="3" class="w-full rounded-xl border border-border bg-background px-4 py-3 text-foreground focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Précisions, marque, modèle..."></textarea>
        </div>
        <input type="hidden" name="_subject" value={`Demande - ${service.name}`} />
        <div class="text-center">
          <button type="submit" class="inline-flex items-center gap-3 rounded-xl bg-secondary px-8 py-5 text-lg font-extrabold text-secondary-foreground shadow-cta hover:brightness-105 transition">Envoyer ma demande</button>
        </div>
      </form>
    </div>
  </section>
  <section class="py-20 bg-background"><div class="container text-center max-w-2xl"><h2 class="text-3xl md:text-4xl mb-4">Un projet de {service.name.toLowerCase()} ?</h2><p class="text-muted-foreground text-lg mb-8">Contactez Anthony pour une étude personnalisée et un devis gratuit.</p><a href={TEL} class="inline-flex items-center gap-3 rounded-xl bg-secondary px-8 py-5 text-lg font-extrabold text-secondary-foreground shadow-cta hover:brightness-105 transition"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg> {PHONE}</a></div></section>
  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"Service","name":`${service.name} à Saint-James (50240) et alentours`,"provider":{"@type":"LocalBusiness","name":"Anthony PRIME","url":"https://www.anthonyprime.fr","telephone":"+33674981599","address":{"@type":"PostalAddress","addressLocality":"Saint-James","addressRegion":"Normandie","postalCode":"50240","addressCountry":"FR"}},"areaServed":["Avranches","Ducey","Pontorson","Fougères","Saint-Hilaire-du-Harcouët","Pontaubault","Antrain","Granville","Saint-Georges-de-Reintembault","Saint-James"],"description":service.tagline})} />
