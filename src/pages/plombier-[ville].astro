---
import BaseLayout from "../layouts/BaseLayout.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import Hero from "../components/Hero.astro"
import TrustBar from "../components/TrustBar.astro"
import { CITIES } from "../lib/cities"
export async function getStaticPaths() { return CITIES.map(city => ({ params: { ville: city.slug }, props: { city } })) }
const { city } = Astro.props
const PHONE = "06 74 98 15 99"
const TEL = "tel:+33674981599"
---
<BaseLayout title={`Plombier Chauffagiste Électricien à ${city.name} (${city.code}) — Anthony PRIME`} description={`Plombier, chauffagiste et électricien à ${city.name} (${city.code}). Intervention rapide par Anthony PRIME, basé à Saint-James (50240). Dépannage rapide, installation PAC, mise aux normes électriques.`} path={`/plombier-${city.slug}`}>
  <Fragment slot="header"><Header /></Fragment>
  <Hero title={`Plombier, Chauffagiste et Électricien à ${city.name}`} tagline={`Interventions rapides à ${city.name} et ses environs. Artisan RGE — devis gratuit.`} />
  <TrustBar />
  <section class="py-20 bg-background"><div class="container max-w-3xl">
    <h2 class="text-3xl md:text-4xl mb-6">Votre artisan de proximité à {city.name}</h2>
    <p class="text-lg text-muted-foreground leading-relaxed mb-8">Basé à Saint-James (50240), Anthony PRIME intervient à {city.name} et dans toute sa région pour tous vos travaux de plomberie, chauffage et électricité. Que ce soit pour une urgence, une rénovation ou un projet neuf, un seul interlocuteur pour l'ensemble de vos besoins techniques.</p>
    <div class="grid sm:grid-cols-2 gap-6 mb-10">
      <div class="rounded-2xl border border-border bg-card p-6 shadow-elegant"><h3 class="font-bold text-xl mb-3">🔧 Plomberie</h3><p class="text-sm text-muted-foreground">Recherche de fuite, pose de chauffe-eau, rénovation salle de bains, sanitaires.</p></div>
      <div class="rounded-2xl border border-border bg-card p-6 shadow-elegant"><h3 class="font-bold text-xl mb-3">🔥 Chauffage</h3><p class="text-sm text-muted-foreground">Pompe à chaleur, chaudière gaz/fioul/bois, plancher chauffant, entretien annuel.</p></div>
      <div class="rounded-2xl border border-border bg-card p-6 shadow-elegant"><h3 class="font-bold text-xl mb-3">⚡ Électricité</h3><p class="text-sm text-muted-foreground">Tableau électrique, mise aux normes, dépannage, éclairage, prises.</p></div>
      <div class="rounded-2xl border border-border bg-card p-6 shadow-elegant"><h3 class="font-bold text-xl mb-3">🚨 Urgence dépannage</h3><p class="text-sm text-muted-foreground">Fuite d'eau, panne de chauffage, coupure électrique — intervention rapide chez les clients existants.</p></div>
    </div>
    <div class="text-center"><a href={TEL} class="inline-flex items-center gap-3 rounded-xl bg-secondary px-8 py-5 text-lg font-extrabold text-secondary-foreground shadow-cta hover:brightness-105 transition"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg> {PHONE}</a></div>
  </div></section>
  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
